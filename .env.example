# ── Docker Compose Build Substitution ──────────────────────
# Docker Compose reads this file for ${VAR} substitution in build args.
# These NEXT_PUBLIC_ vars are needed at build time because Next.js
# bakes them into client-side JS during `npm run build`.
#
# Values here should mirror frontend/.env.local for NEXT_PUBLIC_ vars.
# Secrets (CLERK_SECRET_KEY, WEBHOOK_SECRET, etc.) are NOT here —
# they are injected at runtime via env_file in docker-compose.yml.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...INSERT_YOUR_KEY...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_SUPABASE_URL=https://...INSERT_YOUR_URL...supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...INSERT_YOUR_ANON_KEY...