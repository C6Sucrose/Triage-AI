# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # backend bypasses RLS for its own operations

# ── Clerk ─────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"  # RS256 public key for JWT verification

# ── Webhook API Key ──────────────────────────────────────
INBOUND_WEBHOOK_API_KEY=your-webhook-api-key   # shared secret for /api/v1/webhooks/inbound-email

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_DB_URL=http://localhost:8000   # local dev default; Docker sets http://chromadb:8000