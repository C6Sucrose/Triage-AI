# Supabase Keys
NEXT_PUBLIC_SUPABASE_URL=https://[your-project-url].supabase.co # Get these from https://app.supabase.com -> Your Project -> Project Settings -> Data API -> API URL Key
SUPABASE_SERVICE_ROLE_KEY=ey... # Get these from https://app.supabase.com -> Your Project -> Project Settings -> API Keys -> Legacy anon, service_role API keys